{
  "name": "@once-upon/firmware",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Enchanted glove firmware tools. Not part of the pnpm workspace; the sketch has no npm deps and the bridge uses only Node built-ins.",
  "scripts": {
    "bridge": "node --experimental-strip-types serial-bridge.ts",
    "simulate": "node --experimental-strip-types serial-bridge.ts --simulate",
    "self-test": "node --experimental-strip-types serial-bridge.ts --self-test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.7.3"
  }
}
