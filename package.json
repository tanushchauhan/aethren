{
  "name": "once-upon-a-memory",
  "private": true,
  "version": "0.0.0",
  "description": "Once Upon a Memory — HackTX 2026 co-op fairy-tale battle game",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @once-upon/client --filter @once-upon/server dev",
    "dev:server": "pnpm --filter @once-upon/server dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test --passWithNoTests"
  }
}
