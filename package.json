{
  "name": "once-upon-a-memory",
  "private": true,
  "version": "0.0.0",
  "description": "Aethren \u2014 an authored fantasy story adventure",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @once-upon/client --filter @once-upon/server dev",
    "dev:server": "pnpm --filter @once-upon/server dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test"
  }
}
