# Copy to server/.env (gitignored). Every AI key is optional: a missing key marks that
# provider unavailable and the server falls back (cached world, prewritten lines,
# speechSynthesis TTS, scripted boss). The server never crashes on a missing key.

PORT=3001
# Public https URL of this server (used for join links and the MCP connector). Defaults to http://localhost:PORT.
PUBLIC_BASE_URL=
# Comma-separated allowed browser origins (e.g. http://localhost:5173). Blank allows all (dev).
CLIENT_ORIGIN=

# --- Meta Muse (Meta Model API, OpenAI-compatible) ---
# Fill these from the Meta Model API console: the key, the OpenAI-compatible base URL,
# and the model IDs for Spark (chat/tools/structured output), Voice Transcribe, Image and TTS.
MUSE_API_KEY=
MUSE_BASE_URL=
MUSE_SPARK_MODEL=
MUSE_TRANSCRIBE_MODEL=
MUSE_IMAGE_MODEL=
MUSE_TTS_MODEL=
MUSE_TTS_VOICE=

# --- TTS fallbacks ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional ElevenLabs model ID override; blank uses the ai/ module default.
ELEVENLABS_MODEL_ID=
OPENAI_API_KEY=
# Optional OpenAI TTS model override; blank uses the ai/ module default.
OPENAI_TTS_MODEL=

# --- MCP Quest Master (/mcp) ---
# Bearer token Muse's connector must send. Required in production; when blank in dev, /mcp accepts unauthenticated requests.
MCP_BEARER_TOKEN=

# Serve the cached demo world instead of calling Muse for world generation.
USE_CACHED_WORLD=false
# Per-call timeout for AI requests, in ms (default 12000).
AI_TIMEOUT_MS=
