# Copy to server/.env (gitignored). Never commit real keys or tokens.
# Blank values fall back to the defaults in src/config.ts (the same values shown below),
# so a full live demo only needs the REQUIRED section. A missing AI key never crashes the
# server: that provider is marked unavailable and the game falls back (cached world,
# prewritten lines, browser speechSynthesis, scripted boss).
# Defaults researched 2026-10-25; the Meta Model API is in public preview, so re-check IDs at dev.meta.ai.

# =====================================================================
# REQUIRED
# =====================================================================

# Meta Model API key (create at dev.meta.ai). Turns on Muse Spark, Voice Transcribe and Image.
MUSE_API_KEY=
# Bearer token the Muse connector must send to /mcp. Required in production; blank in dev allows unauthenticated /mcp.
MCP_BEARER_TOKEN=

# =====================================================================
# OPTIONAL
# =====================================================================

# --- Server / deploy ---
PORT=3001
# Public https URL of this server (join links, MCP connector URL). Blank uses http://localhost:PORT.
PUBLIC_BASE_URL=
# Comma-separated allowed browser origins (e.g. http://localhost:5173). Blank allows all (dev only).
CLIENT_ORIGIN=

# --- Muse model overrides (Meta Model API) ---
# OpenAI-compatible base URL. Source: https://docs.litellm.ai/docs/providers/meta.md
MUSE_BASE_URL=https://api.meta.ai/v1
# Chat, structured output, tool calling. $1.25 in / $4.25 out per 1M tokens ($0.15 cached in).
# muse-spark-1.3-contributor is $0.10/$0.20 but ~100 RPM and Meta may train on the data (our chat logs), so not the default.
# Source: https://docs.litellm.ai/blog/muse_spark_1_3
MUSE_SPARK_MODEL=muse-spark-1.3
# Speech-to-text, ~$0.18 per audio hour. Native endpoint is POST /v1/asr/transcribe (WAV PCM mono 16-bit), not /audio/transcriptions.
# Source: https://docs.litellm.ai/docs/providers/meta.md , https://www.orcarouter.ai/blog/muse-voice-transcribe
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# Image generation via /v1/images/generations, $0.01 per image.
# Source: https://developer.meta.com/ai/resources/blog/build-with-muse-Image/ , https://www.orcarouter.ai/blog/muse-image
MUSE_IMAGE_MODEL=muse-image-1.0
# Muse TTS: no TTS/speech model found on the Meta Model API (Muse Voice is speech-to-text only), so left blank
# and Muse TTS stays off. Set both only if Meta ships one. Source: https://www.orcarouter.ai/blog/muse-voice-transcribe
MUSE_TTS_MODEL=
MUSE_TTS_VOICE=

# --- TTS fallbacks (tried in order when Muse TTS is off: ElevenLabs, OpenAI, then browser speechSynthesis) ---
# ElevenLabs key. Blank skips ElevenLabs.
ELEVENLABS_API_KEY=
# Premade voice "George - Warm, Captivating Storyteller". Source: https://json2video.com/ai-voices/elevenlabs/voices/JBFqnCBsd6RMkjVDRZzb/
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Cheapest, lowest-latency model (~75 ms), ~$0.05 per 1K chars on the API (third-party figure).
# Source: https://elevenlabs.io/docs/models , price: https://artificialanalysis.ai/text-to-speech/models/flash-v2-5
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# OpenAI key. Blank skips OpenAI TTS.
OPENAI_API_KEY=
# Cheapest OpenAI TTS, ~$0.015 per audio minute ($0.60/1M text in, $12/1M audio out; third-party figure).
# Source: https://developers.openai.com/api/docs/guides/text-to-speech , price: https://techsy.io/en/blog/best-tts-apis-developers
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Built-in voice; the OpenAI guide recommends marin or cedar for best quality. Source: https://developers.openai.com/api/docs/guides/text-to-speech
OPENAI_TTS_VOICE=marin

# --- MCP Quest Master (/mcp) ---
# MCP_BEARER_TOKEN is in REQUIRED above; nothing else to set here.

# --- Demo / fallback flags ---
# true serves the cached demo world instead of calling Muse for world generation.
USE_CACHED_WORLD=false
# Per-call timeout for AI requests, in ms.
AI_TIMEOUT_MS=12000
