    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "multer": "^2.0.0",
    "openai": "^5.0.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.3",
