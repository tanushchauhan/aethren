{
  "name": "@once-upon/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Authoritative game server, Muse AI pipeline and MCP Quest Master for Once Upon a Memory",
  "scripts": {
    "dev": "tsx watch src/index.ts",
